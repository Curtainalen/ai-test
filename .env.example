APP_ENV=development
APP_NAME=AI Test
API_PREFIX=/api
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:8080

POSTGRES_DB=ai_test
POSTGRES_USER=ai_test
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ai_test:change-me@postgres:5432/ai_test
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

UPLOAD_ROOT=/app/data/uploads
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
MAX_DOCX_IMAGES=200
DOCUMENT_PARSE_TIMEOUT_SECONDS=120

REMOTE_OPENAPI_ENABLED=false
# Exact hosts or wildcard subdomains, for example: api.example.com,*.internal.example.com
REMOTE_OPENAPI_ALLOWED_HOSTS=
REMOTE_OPENAPI_MAX_BYTES=5242880
REMOTE_OPENAPI_TIMEOUT_SECONDS=10

# Runtime secrets are injected by name and referenced in assets as secret://login_password.
# AITEST_SECRET_LOGIN_PASSWORD=replace-me
